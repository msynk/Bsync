<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <Description>Test helper: writes to a SQLite replica until it is killed, so tests can check durability after real process termination.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Bsync\Bsync\Bsync.csproj" />
    <ProjectReference Include="..\..\Bsync\Bsync.Storage.Sqlite\Bsync.Storage.Sqlite.csproj" />
    <!-- The store leaves the native SQLite build to the application. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.12" />
  </ItemGroup>

</Project>
