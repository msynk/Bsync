<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <Description>An ASP.NET Core host built only from the Bsync packages: endpoints, blob routes, the browser store's static assets, and a SQLite replica (--smoke).</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Bsync" Version="$(BsyncPackageVersion)" />
    <PackageReference Include="Bsync.Blazor" Version="$(BsyncPackageVersion)" />
    <PackageReference Include="Bsync.Server.AspNetCore" Version="$(BsyncPackageVersion)" />
    <PackageReference Include="Bsync.Server.SqlServer" Version="$(BsyncPackageVersion)" />
    <PackageReference Include="Bsync.Storage.Sqlite" Version="$(BsyncPackageVersion)" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.12" />
  </ItemGroup>

</Project>
