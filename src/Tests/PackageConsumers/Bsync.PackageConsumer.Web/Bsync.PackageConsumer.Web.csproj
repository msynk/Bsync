<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <Description>An ASP.NET Core host built only from the Bsync packages: endpoints, blob routes, the browser store's static assets, and a SQLite replica (--smoke).</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Bsync" />
    <PackageReference Include="Bsync.Blazor" />
    <PackageReference Include="Bsync.Server.AspNetCore" />
    <PackageReference Include="Bsync.Server.PostgreSql" />
    <PackageReference Include="Bsync.Server.SqlServer" />
    <PackageReference Include="Bsync.Storage.Sqlite" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
  </ItemGroup>

</Project>
