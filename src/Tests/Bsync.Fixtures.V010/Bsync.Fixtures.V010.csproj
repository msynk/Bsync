<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Writes src/Tests/Bsync.Tests/Fixtures/replica-0.1.0.db with the published 0.1.0 packages (task G2: migration from the
    published store schema). Not part of the solution: it references the old packages from nuget.org on purpose.
    Run it with "dotnet run", passing the output path, from the repository root.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Bsync" Version="0.1.0" />
    <PackageReference Include="Bsync.Storage.Sqlite" Version="0.1.0" />
  </ItemGroup>

</Project>
