<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- A private package cache, so a re-packed prerelease with the same version is never served stale. -->
  <config>
    <add key="globalPackagesFolder" value="../../artifacts/package-cache" />
  </config>
  <packageSources>
    <clear />
    <add key="local" value="../../artifacts/packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <!-- Bsync packages only from the local pack; everything else from nuget.org. -->
  <packageSourceMapping>
    <packageSource key="local">
      <package pattern="Bsync" />
      <package pattern="Bsync.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
