    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bsync.Samples.Tasks.Client\Bsync.Samples.Tasks.Client.csproj" />
    <ProjectReference Include="..\Bsync.Samples.Tasks.Shared\Bsync.Samples.Tasks.Shared.csproj" />
    <ProjectReference Include="..\..\Bsync\Bsync.Server.AspNetCore\Bsync.Server.AspNetCore.csproj" />
    <ProjectReference Include="..\..\Bsync\Bsync.Server.SqlServer\Bsync.Server.SqlServer.csproj" />
    <ProjectReference Include="..\..\Bsync\Bsync.Server.Blobs.S3\Bsync.Server.Blobs.S3.csproj" />
  </ItemGroup>

</Project>
