<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <Description>Sample: a relational system of record (EF Core on SQL Server) replicated by the SQL Server authority, with a write handler, a publisher used by an ordinary API endpoint and bearer-token authentication (task B5, ADR-014).</Description>
