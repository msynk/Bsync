<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><IsPackable>false</IsPackable>
    <RestoreConfigFile Condition="'$(BsyncPackageVersion)' != ''">$(MSBuildThisFileDirectory)../../Tests/PackageConsumers/NuGet.Config</RestoreConfigFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="AWSSDK.S3" Version="4.0.104.1" />
    <PackageReference Include="Microsoft.Playwright" Version="1.63.0" />
    <ProjectReference Include="../../Bsync/Bsync.Server.AspNetCore/Bsync.Server.AspNetCore.csproj" Condition="'$(BsyncPackageVersion)' == ''" />
    <PackageReference Include="Bsync.Server.AspNetCore" Version="$(BsyncPackageVersion)" Condition="'$(BsyncPackageVersion)' != ''" />
    <Compile Include="../../Samples/Bsync.Samples.Tasks.Server/S3BlobStore.cs" Link="S3BlobStore.cs" />
  </ItemGroup>
</Project>
