<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsAotCompatible>true</IsAotCompatible>
    <Description>Blazor integration for Bsync: a durable browser store (IndexedDB) for Blazor WebAssembly, PWAs and Interactive WebAssembly/Auto after activation, and a server-connected collection (Interactive Server, prerendering, static SSR) that writes as the authenticated Blazor user. The collection API and the local replica session are in Bsync.</Description>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" Version="10.0.12" />
    <PackageReference Include="Microsoft.JSInterop" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bsync\Bsync.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Bsync.Tests" />
    <InternalsVisibleTo Include="Bsync.Tests.BrowserHost" />
  </ItemGroup>

</Project>
